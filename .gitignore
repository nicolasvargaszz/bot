# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# OS/editor noise
.DS_Store
.idea/
.vscode/

# Local data outputs
*.db
*.sqlite
*.sqlite3
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/legacy/*
!data/legacy/.gitkeep

# Browser/session state
playwright/.auth/
browser_profiles/
user_data_dir/
storage_state.json

# n8n/Evolution local state
n8n/.n8n/
n8n_data/
evolution_instances/
evolution_store/
postgres_data/
redis_data/

# Live n8n exports can contain local workflow IDs, credential names, calendar IDs,
# chat IDs, and other operational metadata. Keep raw exports in n8n/exports/ and
# track only sanitized templates under n8n/workflows/.
n8n/exports/

# Generated exports
*.xlsx
*.csv
*.log

# Private business strategy and local-only assets
docs/business/
prompts/
data/templates/

# Personal documents that must never be tracked in a public repo
*.pdf

# Personal reading room (reports, checklists, lead data, personal docs)
docs/handbook/
