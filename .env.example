# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Local services
DATABASE_URL=postgresql://automation:automation@localhost:5432/automation
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Local dashboard/scraping
SCRAPE_DELAY_SECONDS=2.0
MAX_RESULTS_PER_QUERY=50
HEADLESS_BROWSER=true
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=nicolas
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5002
DASHBOARD_DEBUG=false

# Google Maps / lead discovery
GOOGLE_MAPS_API_KEY=
OUTSCRAPER_API_KEY=

# AI provider for the n8n workflow: "azure" (Azure OpenAI, Student Pack
# credits) or "gemini" (Gemini API free tier). Leave empty to prefer Azure
# automatically when AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_KEY are set.
AI_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional per-task overrides; both fall back to AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_CLASSIFICATION_DEPLOYMENT=
AZURE_OPENAI_RESPONSE_DEPLOYMENT=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_CLASSIFICATION_MODEL=gemini-2.5-flash
GEMINI_RESPONSE_MODEL=gemini-2.5-pro

# CRM / notifications, currently optional
NOTION_TOKEN=
NOTION_DATABASE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CALENDAR_ID=primary

# Optional deployment and repository integrations
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_ORG=
GITHUB_PAGES_DOMAIN=
RESEND_API_KEY=
VERCEL_TOKEN=
VERCEL_ORG_ID=
NETLIFY_TOKEN=
NETLIFY_SITE_ID=

# Evolution API / n8n deployment
EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_SERVER_URL=http://localhost:8080
# WhatsApp instance name inside Evolution API (used by the session monitor)
EVOLUTION_INSTANCE=autobots-main
EVOLUTION_SESSION_PHONE_VERSION=2.3000.10216511034
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-buffer
# n8n access control is the owner account created on first login; the
# editor port is bound to 127.0.0.1 and reached through an SSH tunnel.
N8N_SECURE_COOKIE=false
N8N_BUFFERED_WEBHOOK_SECRET=

# Message buffer service
EVOLUTION_WEBHOOK_URL=http://message-buffer:8081/webhook/evolution
EVOLUTION_BUFFER_WEBHOOK_SECRET=
MESSAGE_BUFFER_SECONDS=8
MESSAGE_BUFFER_MAX_MESSAGES=20
MESSAGE_BUFFER_MAX_AGE_SECONDS=120
MESSAGE_BUFFER_DEDUP_TTL_SECONDS=86400
MESSAGE_BUFFER_POLL_SECONDS=1.0
N8N_REQUEST_TIMEOUT_SECONDS=10.0
# Voice notes: disabled | whisper_api (OpenAI) | azure_whisper (Student Pack)
TRANSCRIPTION_PROVIDER=disabled
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# azure_whisper reuses AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_KEY above
AZURE_WHISPER_DEPLOYMENT=
AUDIO_DOWNLOAD_TIMEOUT_SECONDS=15
MAX_AUDIO_SIZE_MB=10

# WhatsApp/Twilio placeholders, not used for outbound automation yet
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
MY_WHATSAPP_NUMBER=

# Tracking placeholders
TRACKING_DOMAIN=
TRACKING_SECRET_KEY=
